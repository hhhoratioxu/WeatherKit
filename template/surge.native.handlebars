[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP,extended-matching
DOMAIN,tether.edge.apple,REJECT-DROP,extended-matching
AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

[Script]
🌤 WeatherKit.availability.response = type=http-response, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/", requires-body=true, max-size=65536, engine=jsc, timeout=5, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v{{@package 'version'}}/availability.surge.bundle.js
🌤 WeatherKit.airQualityScale.request = type=http-request, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/", engine=jsc, timeout=5, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v{{@package 'version'}}/scale.surge.bundle.js
🌤 WeatherKit.weatherAlerts.html.request = type=http-request, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?(?:[^#]*&)?ids=[^&#]*-[0-9]{9}(?:&|$)", engine=webview, timeout=25, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v{{@package 'version'}}/request.surge.bundle.js, argument={{{scriptParams}}}
🌤 WeatherKit.weatherAlerts.api.request = type=http-request, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?(?:[^#]*&)?ids=-?[0-9]+(?:\.[0-9]+)?,-?[0-9]+(?:\.[0-9]+)?(?:&|$)", engine=webview, timeout=25, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v{{@package 'version'}}/request.surge.bundle.js, argument={{{scriptParams}}}
🌤 WeatherKit.v3.weather.request = type=http-request, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v3\/weather\/", engine=jsc, timeout=5, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v{{@package 'version'}}/transport.surge.bundle.js
🌤 WeatherKit.v2.weather.response = type=http-response, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/", requires-body=true, binary-body-mode=true, max-size=4194304, engine=webview, timeout=25, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v{{@package 'version'}}/response.surge.bundle.js, argument={{{scriptParams}}}
🌤 WeatherKit.v3.weather.response = type=http-response, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v3\/weather\/", requires-body=true, max-size=4194304, engine=webview, timeout=25, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v{{@package 'version'}}/response.surge.bundle.js, argument={{{scriptParams}}}

[MITM]
hostname = %APPEND% weatherkit.apple.com
