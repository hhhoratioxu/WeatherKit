#!name =  iRingo: 🌤 WeatherKit
#!desc = iOS 18 & macOS 15 & watchOS 11\n1.解锁全部天气功能\n2.修改空气质量数据\n3.修改下一小时降水数据\n4.修改天气数据\n5.修改天气预警数据
#!openUrl = http://boxjs.com/#/app/iRingo.WeatherKit
#!author = VirgilClyne[https://github.com/VirgilClyne],WordlessEcho[https://github.com/WordlessEcho],001[https://github.com/001ProMax],hhh2210[https://github.com/hhh2210],hhhoratioxu[https://github.com/hhhoratioxu]
#!homepage = https://NSRingo.github.io/guide/Weather/weather-kit
#!icon = https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!category =  iRingo
#!date = 2026-11-08 23:04:42
#!version = 3.3.5
#!arguments = DataSets:"airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,weatherAlerts",Weather_Provider:"ColorfulClouds",WeatherAlerts_Provider:"QWeatherWeb",NextHour_Provider:"ColorfulClouds",AirQuality_Current_Pollutants_Provider:"ColorfulClouds",AirQuality_Calculate_Algorithm:"EU_EAQI",API_ColorfulClouds_Token:"",API_QWeather_Host:"devapi.qweather.com",API_QWeather_Token:"",API_WAQI_Token:"",Storage:"Argument",LogLevel:"WARN",RequestCache_TTL:"60",RequestCache_ForecastTTL:"180",RequestCache_MinutelyTTL:"15",RequestCache_AlertsTTL:"15",RequestCache_BudgetMs:"8000",RequestCache_CooldownSeconds:"30",RequestCache_Diagnostics:false,Region_Fallback:"Auto",ProviderFallback_Enabled:false
#!arguments-desc = DataSets: [数据集]\n    ├ airQuality: 空气质量\n    ├ currentWeather: 当前天气\n    ├ forecastDaily: 每日预报\n    ├ forecastHourly: 每小时预报\n    ├ forecastNextHour: 未来一小时降水强度\n    └ weatherAlerts: 天气预警\n选择需要解析并处理的数据集；未选择的数据槽始终保持原样透传，不作修改。\n\nWeather.Provider: [天气] 数据源\n    ├ WeatherKit: WeatherKit（不替换）\n    ├ ColorfulClouds: 彩云天气\n    └ QWeather: 和风天气\n使用选定的数据源替换天气数据。\n\nWeatherAlerts.Provider: [天气预警] 数据源\n    ├ WeatherKit: WeatherKit（不修改）\n    ├ QWeatherWeb: 和风天气网页\n    ├ QWeather: 和风天气 API\n    └ ColorfulClouds: 彩云天气 API\n使用选定的数据源处理天气预警数据。\n\nNextHour.Provider: [未来一小时降水强度] 数据源\n    ├ WeatherKit: WeatherKit（不添加）\n    ├ ColorfulClouds: 彩云天气\n    └ QWeather: 和风天气\n使用选定的数据源填充未来一小时降水强度的数据。\n\nAirQuality.Current.Pollutants.Provider: [今日污染物] 数据源\n    ├ ColorfulClouds: 彩云天气\n    └ QWeather: 和风天气\n使用选定的数据源填补污染物数据。\n\nAirQuality.Calculate.Algorithm: [iRingo内置算法] 算法\n    ├ None: 不转换\n    ├ UBA: 德国LQI（FB001846）\n    ├ EU_EAQI: 欧盟EAQI（ETC HE Report 2024/17）\n    ├ WAQI_InstantCast_US: 美标InstantCast（EPA-454/B-24-002）\n    ├ WAQI_InstantCast_CN: 国标InstantCast（HJ 633—2012）\n    ├ WAQI_InstantCast_CN_25_DRAFT: 国标InstantCast（HJ 633 2025年草案）\n    ├ CA_AQHI: 加拿大AQHI（10.17269/s41997-019-00237-w）\n    ├ HK_AQHI: 香港AQHI\n    ├ AQHI_Multi_CN: AQHI-Multi（中国）\n    ├ AQHI_Multi_CN_HK: AQHI-Multi（中国+香港）\n    ├ CN_DEATH_AQHI: 中国（致死风险）AQHI\n    └ CN_DEATH_HK_AQHI: 中国（致死风险）+香港AQHI\n使用内置算法，通过污染物数据本地计算空气指数。InstantCast源自于WAQI，美标版本使用了WAQI的臭氧标准。\n\nAPI.ColorfulClouds.Token: [API] 彩云天气令牌\n彩云天气 API 令牌\n\nAPI.QWeather.Host: [API] 和风天气主机\n和风天气 API 使用的主机名\n\nAPI.QWeather.Token: [API] 和风天气令牌\n和风天气 API 令牌\n\nAPI.WAQI.Token: [API] WAQI 令牌\nWAQI API 令牌，填写此字段将自动使用WAQI高级API\n\nStorage: [储存] 配置类型\n    ├ Argument: 优先使用插件选项与模块参数等，由 $argument 传入的配置，$argument 不包含的设置项由 PersistentStore (BoxJs) 提供\n    ├ PersistentStore: 只使用来自 BoxJs 等，由 $persistentStore 提供的配置\n    └ database: 只使用由作者的 database.mjs 文件提供的默认配置，其他任何自定义配置不再起作用\n选择要使用的配置类型。未设置此选项或不通过此选项的旧版本的配置顺序依旧是 $persistentStore (BoxJs) > $argument > database。\n\nLogLevel: [调试] 日志等级\n    ├ OFF: 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。\n\nRequestCache.TTL: [请求缓存] 实况与空气质量（秒）\n0 禁用所有已完成响应缓存，仍合并在途请求。最大 300 秒。\n\nRequestCache.ForecastTTL: [请求缓存] 小时与每日预报（秒）\n变化较慢的预报缓存，最大 300 秒。\n\nRequestCache.MinutelyTTL: [请求缓存] 分钟降雨（秒）\n分钟降雨缓存，最大 30 秒。\n\nRequestCache.AlertsTTL: [请求缓存] 天气预警（秒）\nJSON 与网页预警缓存，最大 30 秒；不使用过期预警。\n\nRequestCache.BudgetMs: [弱网] 网络发起预算（毫秒）\n1000–15000 毫秒。队列与后续请求共享预算；已发出的请求仍等待原生回调，不取消请求或提前完成。\n\nRequestCache.CooldownSeconds: [弱网] 失败冷却（秒）\n相同接口连续失败两次后冷却；鉴权错误与限流立即冷却。最大 120 秒；0 禁用。\n\nRequestCache.Diagnostics: [诊断] 输出运行统计\n每次执行汇总缓存、请求、耗时与回退原因，不包含令牌、原始地址或坐标。\n\nRegion.Fallback: [地区] 缺少 country 时\n    ├ Auto: 自动保守判断\n    ├ Locale: 沿用语言区域\n    ├ CN: 中国大陆\n    ├ HK: 香港\n    ├ MO: 澳门\n    └ TW: 台湾\n明确的 country 参数始终优先；自动模式使用同坐标确认记录与离线多边形，边界不确定时沿用语言区域。\n\nProviderFallback.Enabled: [数据源] 允许备用查询\n默认仅使用选定来源，失败保留 Apple 数据。开启后，原数据也不可用且已配置另一来源专用凭据时，才尝试一次备用查询。\n

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP,extended-matching
DOMAIN,tether.edge.apple,REJECT-DROP,extended-matching
AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

[Script]
🌤 WeatherKit.availability.response = type=http-response, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/", requires-body=true, max-size=65536, engine=jsc, timeout=5, script-path=https://raw.githubusercontent.com/hhhoratioxu/WeatherKit/v3.3.5/Surge/script/availability.surge.bundle.js
🌤 WeatherKit.airQualityScale.request = type=http-request, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/", engine=jsc, timeout=5, script-path=https://raw.githubusercontent.com/hhhoratioxu/WeatherKit/v3.3.5/Surge/script/scale.surge.bundle.js
🌤 WeatherKit.weatherAlerts.html.request = type=http-request, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?(?:[^#]*&)?ids=[^&#]*-[0-9]{9}(?:&|$)", engine=webview, timeout=25, script-path=https://raw.githubusercontent.com/hhhoratioxu/WeatherKit/v3.3.5/Surge/script/request.surge.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather_Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts_Provider}}}"&NextHour.Provider="{{{NextHour_Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality_Current_Pollutants_Provider}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality_Calculate_Algorithm}}}"&API.ColorfulClouds.Token="{{{API_ColorfulClouds_Token}}}"&API.QWeather.Host="{{{API_QWeather_Host}}}"&API.QWeather.Token="{{{API_QWeather_Token}}}"&API.WAQI.Token="{{{API_WAQI_Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"&RequestCache.TTL="{{{RequestCache_TTL}}}"&RequestCache.ForecastTTL="{{{RequestCache_ForecastTTL}}}"&RequestCache.MinutelyTTL="{{{RequestCache_MinutelyTTL}}}"&RequestCache.AlertsTTL="{{{RequestCache_AlertsTTL}}}"&RequestCache.BudgetMs="{{{RequestCache_BudgetMs}}}"&RequestCache.CooldownSeconds="{{{RequestCache_CooldownSeconds}}}"&RequestCache.Diagnostics="{{{RequestCache_Diagnostics}}}"&Region.Fallback="{{{Region_Fallback}}}"&ProviderFallback.Enabled="{{{ProviderFallback_Enabled}}}"
🌤 WeatherKit.weatherAlerts.api.request = type=http-request, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?(?:[^#]*&)?ids=-?[0-9]+(?:\.[0-9]+)?,-?[0-9]+(?:\.[0-9]+)?(?:&|$)", engine=webview, timeout=25, script-path=https://raw.githubusercontent.com/hhhoratioxu/WeatherKit/v3.3.5/Surge/script/request.surge.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather_Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts_Provider}}}"&NextHour.Provider="{{{NextHour_Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality_Current_Pollutants_Provider}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality_Calculate_Algorithm}}}"&API.ColorfulClouds.Token="{{{API_ColorfulClouds_Token}}}"&API.QWeather.Host="{{{API_QWeather_Host}}}"&API.QWeather.Token="{{{API_QWeather_Token}}}"&API.WAQI.Token="{{{API_WAQI_Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"&RequestCache.TTL="{{{RequestCache_TTL}}}"&RequestCache.ForecastTTL="{{{RequestCache_ForecastTTL}}}"&RequestCache.MinutelyTTL="{{{RequestCache_MinutelyTTL}}}"&RequestCache.AlertsTTL="{{{RequestCache_AlertsTTL}}}"&RequestCache.BudgetMs="{{{RequestCache_BudgetMs}}}"&RequestCache.CooldownSeconds="{{{RequestCache_CooldownSeconds}}}"&RequestCache.Diagnostics="{{{RequestCache_Diagnostics}}}"&Region.Fallback="{{{Region_Fallback}}}"&ProviderFallback.Enabled="{{{ProviderFallback_Enabled}}}"
🌤 WeatherKit.v3.weather.request = type=http-request, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v3\/weather\/", engine=jsc, timeout=5, script-path=https://raw.githubusercontent.com/hhhoratioxu/WeatherKit/v3.3.5/Surge/script/transport.surge.bundle.js
🌤 WeatherKit.v2.weather.response = type=http-response, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/", requires-body=true, binary-body-mode=true, max-size=4194304, engine=webview, timeout=25, script-path=https://raw.githubusercontent.com/hhhoratioxu/WeatherKit/v3.3.5/Surge/script/response.surge.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather_Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts_Provider}}}"&NextHour.Provider="{{{NextHour_Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality_Current_Pollutants_Provider}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality_Calculate_Algorithm}}}"&API.ColorfulClouds.Token="{{{API_ColorfulClouds_Token}}}"&API.QWeather.Host="{{{API_QWeather_Host}}}"&API.QWeather.Token="{{{API_QWeather_Token}}}"&API.WAQI.Token="{{{API_WAQI_Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"&RequestCache.TTL="{{{RequestCache_TTL}}}"&RequestCache.ForecastTTL="{{{RequestCache_ForecastTTL}}}"&RequestCache.MinutelyTTL="{{{RequestCache_MinutelyTTL}}}"&RequestCache.AlertsTTL="{{{RequestCache_AlertsTTL}}}"&RequestCache.BudgetMs="{{{RequestCache_BudgetMs}}}"&RequestCache.CooldownSeconds="{{{RequestCache_CooldownSeconds}}}"&RequestCache.Diagnostics="{{{RequestCache_Diagnostics}}}"&Region.Fallback="{{{Region_Fallback}}}"&ProviderFallback.Enabled="{{{ProviderFallback_Enabled}}}"
🌤 WeatherKit.v3.weather.response = type=http-response, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v3\/weather\/", requires-body=true, max-size=4194304, engine=webview, timeout=25, script-path=https://raw.githubusercontent.com/hhhoratioxu/WeatherKit/v3.3.5/Surge/script/response.surge.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather_Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts_Provider}}}"&NextHour.Provider="{{{NextHour_Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality_Current_Pollutants_Provider}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality_Calculate_Algorithm}}}"&API.ColorfulClouds.Token="{{{API_ColorfulClouds_Token}}}"&API.QWeather.Host="{{{API_QWeather_Host}}}"&API.QWeather.Token="{{{API_QWeather_Token}}}"&API.WAQI.Token="{{{API_WAQI_Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"&RequestCache.TTL="{{{RequestCache_TTL}}}"&RequestCache.ForecastTTL="{{{RequestCache_ForecastTTL}}}"&RequestCache.MinutelyTTL="{{{RequestCache_MinutelyTTL}}}"&RequestCache.AlertsTTL="{{{RequestCache_AlertsTTL}}}"&RequestCache.BudgetMs="{{{RequestCache_BudgetMs}}}"&RequestCache.CooldownSeconds="{{{RequestCache_CooldownSeconds}}}"&RequestCache.Diagnostics="{{{RequestCache_Diagnostics}}}"&Region.Fallback="{{{Region_Fallback}}}"&ProviderFallback.Enabled="{{{ProviderFallback_Enabled}}}"

[MITM]
hostname = %APPEND% weatherkit.apple.com
